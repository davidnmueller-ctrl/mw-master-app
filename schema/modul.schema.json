{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mw-master-app/schema/modul.schema.json",
  "title": "module/<CODE>.json",
  "description": "Ein Modul des gemeinsamen Katalogs. Dateiname = Modulcode.",
  "type": "object",
  "required": ["code", "titel", "cp", "kategorien", "turnus"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "titel": { "type": "string", "minLength": 1 },
    "titelEn": { "type": "string" },
    "cp": { "type": "number", "exclusiveMinimum": 0 },
    "kategorien": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Erlaubte Kategorien (ids aus regeln.json); die erste ist der Vorschlag."
    },
    "unterbereich": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "turnus": { "enum": ["WS", "SS", "WS+SS", "unregelmaessig"] },
    "sprache": { "type": "string" },
    "leitung": { "type": "string" },
    "kurzbeschreibung": { "type": "string" },
    "pruefung": { "type": "string" },
    "links": {
      "type": "object",
      "properties": {
        "modul": { "type": "string", "pattern": "^https?://" },
        "lehrveranstaltungen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["semester", "url"],
            "properties": {
              "semester": { "$ref": "#/$defs/semester" },
              "url": { "type": "string", "pattern": "^https?://" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "angebot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["semester", "status"],
        "properties": {
          "semester": { "$ref": "#/$defs/semester" },
          "status": { "enum": ["bestaetigt", "erwartet"] }
        },
        "additionalProperties": true
      }
    },
    "notenspiegel": {
      "type": "array",
      "items": { "$ref": "#/$defs/notenspiegel" }
    },
    "kommentare": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "datum": { "$ref": "#/$defs/datum" },
          "von": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "stand": { "$ref": "#/$defs/datum" },
    "quellen": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true,
  "$defs": {
    "semester": {
      "type": "string",
      "pattern": "^(WS [0-9]{2}/[0-9]{2}|SS [0-9]{2})$",
      "description": "z. B. \"WS 26/27\" oder \"SS 27\""
    },
    "datum": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notenspiegel": {
      "type": "object",
      "required": ["termin", "semester", "verteilung", "nichtErschienen"],
      "properties": {
        "termin": { "type": "string", "description": "Bezeichnung wie im Screenshot, z. B. \"FA 24W\"" },
        "semester": { "$ref": "#/$defs/semester" },
        "art": { "enum": ["Haupttermin", "Wiederholung", "unbekannt"] },
        "pruefungsdatum": { "oneOf": [{ "$ref": "#/$defs/datum" }, { "type": "null" }] },
        "angemeldet": { "type": "integer", "minimum": 0 },
        "verteilung": {
          "type": "object",
          "description": "Anzahl je Notenstufe (ohne \"nicht erschienen\"). Schlüssel \"x.y\" von \"1.0\" bis \"5.0\" mit genau einer Nachkommastelle. Außer den Standardstufen kommen Zwischenstufen vor, z. B. 1.4 / 2.4 / 3.4 bei Notenbonus (seit 1.1) oder 1.5 / 2.5 / 3.1 (seit 1.2).",
          "propertyNames": { "pattern": "^([1-4]\\.[0-9]|5\\.0)$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "notenbonus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Die Verteilung enthält bereits einen Notenbonus dieser Größe, z. B. 0.3 (seit 1.1)."
        },
        "hinweis": { "type": "string", "description": "Kurze Notiz zu diesem Termin, wird in der Detailansicht angezeigt (seit 1.1)." },
        "nichtErschienen": { "type": "integer", "minimum": 0 },
        "tumonline": {
          "type": "object",
          "properties": {
            "angetreten": { "type": "integer", "minimum": 0 },
            "quoteNegativ": { "type": "number", "minimum": 0, "maximum": 1 },
            "schnittGesamt": { "type": "number" },
            "schnittBestanden": { "type": "number" }
          },
          "additionalProperties": true
        },
        "erfasstAm": { "$ref": "#/$defs/datum" },
        "quelle": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
