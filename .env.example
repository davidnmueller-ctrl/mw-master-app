# Copy to .env.local for development or .env.production.local for release builds.
# The API base URL is the exact Cloud Run HTTPS origin, with no path.
VITE_REVIEWS_API_BASE_URL=https://YOUR_CLOUD_RUN_HOST.run.app

# Firebase Web app configuration (public client identifiers, never a service-account key).
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# OAuth client type: Desktop app, from the same Google Cloud project.
VITE_GOOGLE_DESKTOP_CLIENT_ID=YOUR_DESKTOP_CLIENT_ID.apps.googleusercontent.com

# Google requires this installed-app client value during code exchange.
# Store it in ignored local env files or a GitHub Actions secret; it is embedded in desktop builds.
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=YOUR_DESKTOP_CLIENT_SECRET
